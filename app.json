{
  "expo": {
    "name": "LingoPop",
    "slug": "lingopop",
    "scheme": "lingopop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lingopop.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow LingoPop to analyze your Mandarin pronunciation.",
        "NSMicrophoneUsageDescription": "Allow LingoPop to access your microphone for Mandarin pronunciation exercises."
      }
    },
    "android": {
      "package": "com.lingopop.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow LingoPop to access your microphone for speaking practice."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow LingoPop to access your microphone for Mandarin pronunciation exercises.",
          "speechRecognitionPermission": "Allow LingoPop to analyze your Mandarin pronunciation."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B35",
          "enableRemoteNotifications": false
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-font",
      "expo-dev-client"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2196f796-b795-42ed-ba5b-32985a31f581"
      }
    },
    "owner": "jaydeveloper"
  }
}
